    },
    "source_contract": "VFileFromMemory installs the non-expanding _vfmSeek callback. The callback rejects invalid whence, negative absolute positions, negative relative/end underflow, and positions beyond the fixed logical size before assigning vfm->offset. The compiled test covers only small, defined off_t values and proves cursor preservation through subsequent reads.",
    "objections": [
      {
        "id": "ordinary-negative-seek-cursor-preservation",
        "objection": "Source inspection alone did not establish runtime cursor preservation for rejected negative seeks on the fixed borrowed-memory backend.",
        "disposition": "RESOLVED_FOR_TESTED_HOST_CASES",
        "resolution": "A bounded native-host executable compiled unchanged pinned vfs-mem.c, exercised valid and invalid SEEK_SET/SEEK_CUR/SEEK_END cases, and read back bytes to verify cursor state after rejection."
      },
      {
        "id": "signed-minimum-and-wide-offset-arithmetic",
        "objection": "The expression (size_t)-offset and mixed size_t/off_t arithmetic are not characterized for signed-minimum values, extreme offsets, or other ABI widths.",
        "disposition": "NEEDS_EVIDENCE",
        "resolution": "The test intentionally uses only small offsets; it does not execute potentially undefined signed-minimum negation or establish portability or large-size behavior."
      },
      {
        "id": "savedata-caller-and-persistence",
        "objection": "The GBA savedata caller, file-backed VFiles, game saves, and durable persistence are outside this executable.",
        "disposition": "NEEDS_EVIDENCE",
        "resolution": "src/gba/core.c is source-traced only; no GBA caller, full mGBA runtime, gameplay, physical Flash, or persistence behavior is claimed."
      }
    ],
    "caller_trace": {
      "source": "src/gba/core.c:1469-1490",
      "claim": "The caller allocates an output buffer, wraps it with VFileFromMemory, calls GBASavedataClone, and checks its bool result. This test neither compiles nor executes that caller and does not establish savedata caller recovery."
    }
  },
